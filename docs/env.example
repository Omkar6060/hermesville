# ~/.hermes/.env on YOUR SERVER (never commit this file anywhere)
# Most lines are written for you by `hermes setup`, `hermes gateway setup`
# and `server/install.sh`. This file only shows what each one means.

# --- Model provider (pick ONE; written by `hermes setup`) ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...

# --- Telegram (written by `hermes gateway setup`) ---
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_ALLOWED_USERS=123456789          # your numeric Telegram id; nobody else can talk to your bot

# --- Hermes API server (written by server/install.sh) ---
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1                 # stays private; only the gateway talks to it
API_SERVER_PORT=8642
API_SERVER_KEY=<64 random hex characters>
API_SERVER_CORS_ORIGINS=https://<username>.github.io

# --- Hermesville login (written by gateway.py set-password / setup-2fa) ---
HV_PASSWORD_HASH=scrypt$...               # only a hash, never the password
HV_TOTP_SECRET=...                        # 2FA secret, also saved in your authenticator app
HV_SESSION_SECRET=...                     # signs login sessions; rotate with `gateway.py logout-all`
# HV_SESSION_DAYS=14

# --- Build agents from the app (only if the gateway can't find `hermes`) ---
# HERMES_BIN=/home/<you>/.local/bin/hermes

# --- My Tracking (optional) ---
# GCAL_ICS_URL=https://calendar.google.com/calendar/ical/<you>%40gmail.com/private-.../basic.ics
# NOTION_TOKEN=ntn_...
# NOTION_DB_ID=<32-character database id>
# GCAL_SA_FILE=/home/<you>/hermesville/gcal-sa.json   # service-account key, lets plans create calendar events (README 8b)
# GCAL_CALENDAR_ID=you@gmail.com

# --- Web search for the news agent (optional) ---
# FIRECRAWL_API_KEY=fc-...

# --- Reel video factory (optional) ---
# PEXELS_API_KEY=...
# REEL_VOICE=en-IN-PrabhatNeural
# REEL_RATE=+8%
